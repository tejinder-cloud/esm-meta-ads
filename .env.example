# =============================================================================
# ESM Overseas — Meta Ads Automation: environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# In production, set these as Railway environment variables instead.
# =============================================================================

# --- Anthropic / Claude Agent SDK -------------------------------------------
ANTHROPIC_API_KEY=                 # Anthropic API key the Claude Agent SDK uses to run agents (model claude-opus-4-8)

# --- Slack (interface: channel #esm-meta-ads) -------------------------------
SLACK_BOT_TOKEN=                   # Bot token (xoxb-...) used to read and post messages
SLACK_APP_TOKEN=                   # App-level token (xapp-...) for Socket Mode (no public URL needed)
SLACK_SIGNING_SECRET=              # Verifies that requests genuinely come from Slack
SLACK_CHANNEL_ID=C05AU0AJSAV       # The #esm-meta-ads channel the team operates in

# --- Meta (Marketing API: campaigns, ad sets, ads, insights) ----------------
META_ACCESS_TOKEN=                 # Long-lived Meta access token for the Marketing API
META_APP_ID=                       # Meta App ID (the app that owns the access token)
META_APP_SECRET=                   # Meta App secret (keep private; used to sign API calls)
META_AD_ACCOUNT_ID=                # Target ad account, e.g. act_1234567890 (INR-denominated)

# --- Google Sheets (shared memory: plans, data, reports) --------------------
GOOGLE_SHEETS_SPREADSHEET_ID=      # ID of the shared Google Sheet (from its URL)
GOOGLE_SHEETS_CLIENT_EMAIL=        # Service account email; share the sheet with this address
GOOGLE_SHEETS_PRIVATE_KEY=         # Service account private key (PEM; keep the literal \n newlines)

# --- Gemini (image & video creative generation) -----------------------------
GEMINI_API_KEY=                    # Google Gemini API key for generating ad images and video

# --- Optimizer (B3): autonomous auto-pause arming ---------------------------
# Leave false/unset for SHADOW mode: the Optimizer only detects + alerts on the
# NZ pilot, it never pauses. Setting it to "true" ARMS autonomous auto-pause —
# a deliberate later step; keep it OFF until then.
OPTIMIZER_ARMED=false              # "true" arms autonomous auto-pause (NZ pilot only); default false = shadow
